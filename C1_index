   }else if(m.type==='IBERONEX_COMITE_EXIT')closeIntegratedCommittee();
   else if(m.type==='IBERONEX_C1_RESTART_REQUEST'){if(confirm('¿Quieres repetir toda la experiencia? Se borrarán las 16 decisiones y el informe de esta partida.')){closeIntegratedCommittee();resetIntegratedCommitteeFrame();reset()}}
 });
 window.IBERONEX_C1_QA=Object.freeze({getState:()=>JSON.parse(JSON.stringify(S)),getPosition:()=>({x:player.x,y:player.y}),getCommittee:()=>S.committee?JSON.parse(JSON.stringify(S.committee)):null,getModal:()=>modalMode,getStoryBible:()=>({...STORY_BIBLE}),getMissionContracts:()=>MISSION_CONTRACTS.map(m=>({...m}))});
})();
