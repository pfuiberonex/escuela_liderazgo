function corridorSegmentOpen(x1,y1,x2,y2){const steps=Math.ceil(Math.hypot(x2-x1,y2-y1)/3);for(let i=1;i<=steps;i++){const t=i/steps;if(blocked(x1+(x2-x1)*t,y1+(y2-y1)*t))return false}return true}
const tile=22,GRID_W=Math.ceil(WORLD.w/tile),GRID_H=Math.ceil(WORLD.h/tile);const key=(x,y)=>x+','+y;
function gridPath(tx,ty){let sx=Math.round(player.x/tile),sy=Math.round(player.y/tile),gx=Math.round(tx/tile),gy=Math.round(ty/tile);const valid=(a,b)=>a>=0&&b>=0&&a<GRID_W&&b<GRID_H&&!blocked(a*tile,b*tile);if(!valid(gx,gy)){let best=null,dd=Infinity;for(let yy=gy-5;yy<=gy+5;yy++)for(let xx=gx-5;xx<=gx+5;xx++){if(valid(xx,yy)){const d=(xx-gx)**2+(yy-gy)**2;if(d<dd){best=[xx,yy];dd=d}}}if(!best)return[];[gx,gy]=best}const open=[{x:sx,y:sy,g:0,f:Math.abs(gx-sx)+Math.abs(gy-sy)}],seen=new Map(),prev=new Map();seen.set(key(sx,sy),0);let loops=0;while(open.length&&loops++<18000){open.sort((a,b)=>a.f-b.f);const u=open.shift();if(u.x===gx&&u.y===gy){let p=[],k=key(gx,gy);while(k&&k!==key(sx,sy)){let[x,y]=k.split(',').map(Number);p.push({x:x*tile,y:y*tile});k=prev.get(k)}return p.reverse()}for(const[dx,dy]of [[1,0],[-1,0],[0,1],[0,-1]]){const nx=u.x+dx,ny=u.y+dy,k=key(nx,ny);if(!valid(nx,ny)||!corridorSegmentOpen(u.x*tile,u.y*tile,nx*tile,ny*tile))continue;let ng=u.g+1;if(ng>=(seen.get(k)??Infinity))continue;seen.set(k,ng);prev.set(k,key(u.x,u.y));open.push({x:nx,y:ny,g:ng,f:ng+Math.abs(nx-gx)+Math.abs(ny-gy)})}}return[]}
